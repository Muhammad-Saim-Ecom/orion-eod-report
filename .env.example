# ─────────────────────────────────────────────────────────────
# Orion EOD Report — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Slack ──────────────────────────────────────────────────────
# Bot User OAuth Token (starts with xoxb-). Needs scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-xxxxxxxx
# Channel ID to post the report into (test channel during development)
SLACK_CHANNEL_ID=C0XXXXXXX

# ── Notion ─────────────────────────────────────────────────────
# Internal integration / personal access token (starts with ntn_ or secret_)
NOTION_TOKEN=ntn_xxxxxxxx
# Master Tracker [EE] database id
NOTION_MASTER_TRACKER_DB_ID=d658b48d-084f-4ed9-90ab-995e0f293846

# ── Time Doctor 2 ──────────────────────────────────────────────
# Preferred auth: a long-lived token (your account password is never stored).
TD_TOKEN=your-time-doctor-token
# Fallback only (avoid): email + password — the app logs in to mint a token.
TD_EMAIL=
TD_PASSWORD=
# Time Doctor company id
TD_COMPANY_ID=Y2Uuqv49XA0GADkC

# ── Behaviour ──────────────────────────────────────────────────
# IANA timezone used to compute "today" and the 5 PM run time.
REPORT_TIMEZONE=America/New_York
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Comma-separated account names to include (must match Time Doctor project / Notion Client names).
REPORT_ACCOUNTS=Made by Mary,Putt View Books,Mind Body Green,WOLFpak,Shepherds Fashion
# How far back (days) to sum cumulative tracked hours when a card has no Actual Start Date.
TRACKED_FALLBACK_DAYS=90
# Local hour (0-23) the scheduled run is allowed to post (17 = 5 PM). Align with the workflow trigger.
REPORT_POST_HOUR=17
# Slack user IDs (U…) to @-mention in the FYI footer, comma-separated (optional).
REPORT_FYI_USER_IDS=
# Skip US federal holidays in addition to weekends (true/false).
SKIP_US_HOLIDAYS=false
# Slack user ID (U…) to DM when a scheduled run fails (optional). Needs im:write scope.
ALERT_SLACK_USER_ID=
# Per-account billing-cycle start day, JSON {"Account":dayOfMonth}. Listed accounts
# show month/week tracked totals; others omit them.
REPORT_CYCLE_START_DAYS={"Made by Mary":8,"WOLFpak":9,"Mind Body Green":13,"Shepherds Fashion":17}
